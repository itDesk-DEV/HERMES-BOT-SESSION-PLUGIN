+def _source_list_param(params: dict, key: str) -> list[str]:
+    """Normalized optional source list; one string and list/tuple/set inputs are accepted."""
+    raw = params.get(key)
+    if raw is None:
+        return []
+    values = [raw] if isinstance(raw, str) else raw if isinstance(raw, (list, tuple, set)) else []
+    seen, result = set(), []
+    for value in values:
+        source = str(value or "").strip().lower()
+        if source and source not in seen:
+            seen.add(source)
+            result.append(source)
+    return result
