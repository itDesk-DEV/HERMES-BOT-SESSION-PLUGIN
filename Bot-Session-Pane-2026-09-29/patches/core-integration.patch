+/** Public bridge for companion desktop panes. Bot Mode's actual selection is
+ * window-local, so a separate plugin cannot import this atom; publish a tiny,
+ * non-sensitive owner descriptor whenever either selection atom changes. */
+type SelectedBotBridge = { connectionId: string; profile: string; selection: string }
+
+declare global {
+  interface Window {
+    __hermesSelectedBot?: SelectedBotBridge
+  }
+}
+
+function publishSelectedBot(selection: unknown): void {
+  const raw = String(selection || '').trim()
+  const separator = raw.indexOf('::')
+  const connectionId = separator >= 0 ? raw.slice(0, separator) : ''
+  const profile = (separator >= 0 ? raw.slice(separator + 2) : raw).trim()
+
+  if (!profile || typeof window === 'undefined') {
+    return
+  }
+
+  const detail: SelectedBotBridge = { connectionId, profile, selection: raw }
+  window.__hermesSelectedBot = detail
+  window.dispatchEvent(new CustomEvent<SelectedBotBridge>('hermes:bots-selected', { detail }))
+}
+
+$selectedBot.listen(publishSelectedBot)
+
