+@method("session.search")
+@_with_db(5017, session_scoped=False)
+def _(rid, params: dict, db) -> dict:
+    """Search the complete persisted transcript of one scoped profile using Hermes' FTS index.
+
+    This is deliberately profile-scoped through ``_profile_db(params)`` rather than the live
+    session registry: inactive and archived conversations remain searchable without resuming
+    them. ``search_messages`` ranks by BM25 and includes phrase/prefix/relaxed fallbacks.
+    """
+    query = _str_param(params, "query") or _str_param(params, "q")
+    if not query:
+        return _ok(rid, {"results": []})
+    try:
+        import re
+
+        limit = max(1, min(_int_param(params, "limit", 50), 100))
+        # Preserve quoted phrases and wildcards; make ordinary terms prefix-searchable.
+        fts_query = " ".join(
+            token if token.startswith('"') or token.endswith("*") else token + "*"
+            for token in re.findall(r'"[^"]*"|\S+', query))
+        raw_hits = db.search_messages(
+            query=fts_query,
+            limit=max(limit * 5, 50),
+            fields=("session_id", "role", "snippet", "session_started"),
+        )
+        results, seen = [], set()
+        for hit in raw_hits:
+            source_id = str(hit.get("session_id") or "")
+            if not source_id:
+                continue
+            try:
+                resolved_id = db.get_compression_tip(source_id) or source_id
+                row = db.get_session_rich_row(resolved_id) or db.get_session(resolved_id)
+            except Exception:
+                continue
+            if not row:
+                continue
+            # A compression lineage may have several message hits; keep its top BM25 hit.
+            lineage_key = str(row.get("id") or resolved_id)
+            if lineage_key in seen:
+                continue
+            seen.add(lineage_key)
+            payload = _session_row_summary(row, resolved_id=resolved_id)
+            payload.update({
+                "snippet": str(hit.get("snippet") or ""),
+                "role": str(hit.get("role") or ""),
+                "last_active": row.get("last_active") or row.get("started_at") or 0,
+                # A display hint only, not a calibrated statistical probability. Ordering remains BM25.
+                "confidence": max(10, 99 - len(results) * 4),
+            })
+            results.append(payload)
+            if len(results) >= limit:
+                break
+        return _ok(rid, {"results": results})
+    except Exception as exc:
+        logger.exception("session.search failed")
+        return _err(rid, 5017, str(exc))
+
