+/** Open one ordinary stored conversation through Bot Mode's ownership path.
+ *
+ * The Sessions pane must not call `host.openSession` independently: a roster
+ * click is concurrently resolving the canonical Bot Chat and Desktop treats
+ * two open requests as competing selections. Bumping the shared generation
+ * first retires that canonical request, then this path owns source activation,
+ * workspace routing, and the side-session tab just as Bot Mode does. */
+export async function openRosterStoredSession(
+  bot: RosterRow,
+  session: { id: string; title?: string; messageCount?: number }
+): Promise<boolean> {
+  const storedId = String(session?.id || '').trim()
+
+  if (!storedId || typeof host.openSession !== 'function') {
+    return false
+  }
+
+  const generation = bumpBotOpenGeneration()
+  const meta = botRosterMeta(bot, $botMeta.get())
+  haptic('tap')
+  saveSelectedRosterBot(bot)
+  const ownerKey = botWorkspaceOwnerKey(bot)
+  setBotsWorkspaceOwner(ownerKey, bot)
+  dismissGroupChatForBotOpen()
+
+  try {
+    await prepareBotSource(bot)
+
+    if (generation !== getBotOpenGeneration()) {
+      return false
+    }
+
+    const route = botConnectionRoute(bot)
+    await host.openSession(storedId, {
+      ...(route ? { route } : {}),
+      profile: bot.name,
+      intent: 'tab',
+      awaitHydration: true,
+      expectHistory: (session.messageCount ?? 1) > 0,
+      forceResume: true,
+      keepAllProfilesScope: true,
+      workspaceMode: 'bots',
+      workspaceOwnerKey: ownerKey,
+      retryHydrationTimeoutOnce: true
+    })
+
+    return generation === getBotOpenGeneration()
+  } catch (error) {
+    if (generation === getBotOpenGeneration()) {
+      notifyBotOpenFailure(error, bot, 'open', displayName(bot, meta))
+    }
+
+    return false
+  }
+}
+
+/** Bridge for independently loaded Desktop panes. The pane supplies only a
+ * profile and stored-session id; Bot Mode resolves the current roster row so
+ * connection aliases and workspace ownership remain canonical. */
+export async function openStoredBotSessionFromPane(request: {
+  profile?: string
+  id?: string
+  title?: string
+  messageCount?: number
+}): Promise<boolean> {
+  const profile = String(request?.profile || '').trim()
+  const bot = $lastRoster.get().find(row => String(row?.name || '') === profile)
+
+  return bot
+    ? openRosterStoredSession(bot, {
+        id: String(request?.id || ''),
+        title: String(request?.title || ''),
+        messageCount: Number(request?.messageCount || 0)
+      })
+    : false
+}
+
+declare global {
+  interface Window {
+    __hermesOpenBotStoredSession?: (request: {
+      profile?: string
+      id?: string
+      title?: string
+      messageCount?: number
+    }) => Promise<boolean>
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.__hermesOpenBotStoredSession = openStoredBotSessionFromPane
+}
